<?xml version="1.0"?>
<package format="2">
  <name>race_stack</name>
  <version>0.1.0</version>
  <description>
    Team racing stack for the MuSHR Vision-Aware Autonomous Racing
    Challenge: waypoint tracking, control, vision, safety and recovery.
  </description>
  <maintainer email="gupta.vidit@icloud.com">Team mushr-vision-racing</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>visualization_msgs</depend>
</package>
