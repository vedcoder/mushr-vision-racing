<launch>
  <!-- Full racing stack: sim must already be running (see sim/README.md) -->
  <rosparam command="load" file="$(find race_stack)/config/params.yaml" />

  <node pkg="race_stack" type="waypoint_manager.py" name="waypoint_manager" output="screen" respawn="true" />
  <node pkg="race_stack" type="sign_detector.py"    name="sign_detector"    output="screen" respawn="true" />
  <node pkg="race_stack" type="lidar_safety.py"     name="lidar_safety"     output="screen" respawn="true" />
  <node pkg="race_stack" type="path_follower.py"    name="path_follower"    output="screen" respawn="true" />
  <node pkg="race_stack" type="speed_planner.py"    name="speed_planner"    output="screen" respawn="true" />
  <node pkg="race_stack" type="arbiter.py"          name="arbiter"          output="screen" respawn="true" />

  <arg name="run_name" default="run" />
  <node pkg="race_stack" type="race_logger.py"      name="race_logger"      output="screen" respawn="true">
    <param name="run_name" value="$(arg run_name)" />
  </node>
</launch>
